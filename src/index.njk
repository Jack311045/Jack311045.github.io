<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1e1e1e">
    <meta name="description" content="{{ profile.name }} — professional portfolio">
    <title>{{ profile.name }} | Portfolio</title>
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
    <script src="{{ '/assets/js/site.js' | url }}" defer></script>
  </head>
  <body>
    <main class="window">
      <header class="titlebar">
        <div class="window-mark" aria-hidden="true">◇</div>
        <span class="window-title">Portfolio — Visual Studio Code</span>
        <span class="window-controls" aria-hidden="true">_ □ ×</span>
      </header>

      <nav class="file-tabs" role="tablist" aria-label="Portfolio files">
        <button class="file-tab is-active" id="tab-readme" role="tab" aria-selected="true" aria-controls="panel-readme" tabindex="0" data-tab="readme"><span class="file-icon icon-md" aria-hidden="true">M</span>README.md</button>
        <button class="file-tab" id="tab-projects" role="tab" aria-selected="false" aria-controls="panel-projects" tabindex="-1" data-tab="projects"><span class="file-icon icon-md" aria-hidden="true">M</span>projects.md</button>
        <button class="file-tab" id="tab-experience" role="tab" aria-selected="false" aria-controls="panel-experience" tabindex="-1" data-tab="experience"><span class="file-icon icon-md" aria-hidden="true">M</span>experience.md</button>
        <button class="file-tab" id="tab-resume" role="tab" aria-selected="false" aria-controls="panel-resume" tabindex="-1" data-tab="resume"><span class="file-icon icon-pdf" aria-hidden="true">P</span>resume.pdf</button>
        <button class="file-tab" id="tab-skills" role="tab" aria-selected="false" aria-controls="panel-skills" tabindex="-1" data-tab="skills"><span class="file-icon icon-md" aria-hidden="true">M</span>skills.md</button>
      </nav>

      <div class="breadcrumb" aria-label="Current location">
        <span>portfolio</span><span aria-hidden="true">›</span><span>Jack Guo</span><span aria-hidden="true">›</span><span id="breadcrumb-file">README.md</span>
      </div>

      <section class="editor" aria-label="Portfolio content">
        <section class="editor-panel is-visible" id="panel-readme" role="tabpanel" aria-labelledby="tab-readme" tabindex="0">
          <div class="line-number" aria-hidden="true">01</div>
          <article class="document">
            <p class="eyebrow">PERSONAL PROFILE</p>
            <h1>{{ profile.name }}</h1>
            <p class="lead">{{ profile.headline }}</p>
            <p class="body-copy">{{ profile.introduction }}</p>
            <div class="section-rule"></div>
            <div class="profile-facts">
              <section class="profile-fact">
                <h2>Education</h2>
                <p>{{ profile.education.institution }}</p>
                <p>{{ profile.education.degree }} · {{ profile.education.major }}</p>
                <p>{{ profile.education.graduation }} · GPA {{ profile.education.gpa }} <span class="muted">({{ profile.education.gpaAsOf }})</span></p>
              </section>
              <section class="profile-fact">
                <h2>Location</h2>
                <p>{{ profile.location }}</p>
              </section>
              <section class="profile-fact">
                <h2>Contact</h2>
                <ul class="contact-list">
                  {% for contact in profile.contacts %}
                    <li><span class="contact-label">{{ contact.label }}</span><a href="{{ contact.href }}" {% if contact.href | isExternalUrl %}target="_blank" rel="noreferrer"{% endif %}>{{ contact.value }}</a></li>
                  {% endfor %}
                </ul>
              </section>
            </div>
          </article>
        </section>

        <section class="editor-panel" id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" tabindex="0" hidden>
          <div class="line-number" aria-hidden="true">02</div>
          <article class="document">
            <p class="eyebrow">SELECTED WORK</p>
            <h1>Projects</h1>
            <p class="body-copy muted">Selected projects in data engineering, applied machine learning, semantic search, and document intelligence.</p>
            <div class="accordion-list" data-accordion-list="projects">
              {% for project in projects.items | sort(false, false, "order") %}
                <details class="entry-card" {% if loop.first %}open{% endif %}>
                  <summary>
                    <span class="entry-title">{{ project.name }}</span>
                    <span class="entry-subtitle">{{ project.summary }}</span>
                    <span class="entry-badge">{{ project.status }}{% if project.dates %}<span class="badge-date">{{ project.dates }}</span>{% endif %}</span>
                  </summary>
                  <div class="entry-content">
                    <ul class="detail-list">{% for highlight in project.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul>
                    {% if project.technology.length %}
                      <p class="detail-label">Technology</p>
                      <ul class="tag-list">{% for technology in project.technology %}<li>{{ technology }}</li>{% endfor %}</ul>
                    {% endif %}
                    {% if project.links.length %}
                      <p class="entry-links">{% for link in project.links %}<a href="{{ link.url }}" target="_blank" rel="noreferrer">{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}</p>
                    {% endif %}
                  </div>
                </details>
              {% endfor %}
              <div class="extra-items" hidden></div>
            </div>
            <button class="text-button show-more" type="button" aria-expanded="false">Show more <span aria-hidden="true">↓</span></button>
          </article>
        </section>

        <section class="editor-panel" id="panel-experience" role="tabpanel" aria-labelledby="tab-experience" tabindex="0" hidden>
          <div class="line-number" aria-hidden="true">03</div>
          <article class="document">
            <p class="eyebrow">WORK HISTORY</p>
            <h1>Experience</h1>
            <p class="body-copy muted">Internship, project, and earlier work across data science, research, and tutoring.</p>
            <div class="accordion-list">
              {% for role in experience.items | sort(false, false, "order") %}
                <details class="entry-card" {% if loop.first %}open{% endif %}>
                  <summary>
                    <span class="entry-title">{{ role.name }}</span>
                    <span class="entry-subtitle">{{ role.role }}{% if role.dates %} · {{ role.dates }}{% endif %}{% if role.location %} · {{ role.location }}{% endif %}</span>
                    <span class="entry-badge">{{ role.category }}</span>
                  </summary>
                  <div class="entry-content">
                    <ul class="detail-list">{% for highlight in role.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul>
                    {% if role.links.length %}
                      <p class="entry-links">{% for link in role.links %}<a href="{{ link.url }}" target="_blank" rel="noreferrer">{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}</p>
                    {% endif %}
                  </div>
                </details>
              {% endfor %}
              <div class="extra-items" hidden></div>
            </div>
            <button class="text-button show-more" type="button" aria-expanded="false">Show more <span aria-hidden="true">↓</span></button>
          </article>
        </section>

        <section class="editor-panel" id="panel-resume" role="tabpanel" aria-labelledby="tab-resume" tabindex="0" hidden>
          <div class="line-number" aria-hidden="true">04</div>
          <article class="document resume-document">
            <p class="eyebrow">DOCUMENT</p>
            <h1>Resume</h1>
            <div class="resume-actions">
              <a class="action-button" href="{{ resume.path | url }}" download>Download PDF</a>
              <a class="action-button action-secondary" href="{{ resume.path | url }}" target="_blank" rel="noreferrer">Open PDF</a>
            </div>
            <iframe class="resume-frame" src="{{ resume.path | url }}#view=FitH" title="Public resume PDF preview"></iframe>
            <p class="resume-note">If the preview is unavailable in your browser, use Open PDF or Download PDF.</p>
          </article>
        </section>

        <section class="editor-panel" id="panel-skills" role="tabpanel" aria-labelledby="tab-skills" tabindex="0" hidden>
          <div class="line-number" aria-hidden="true">05</div>
          <article class="document">
            <p class="eyebrow">CAPABILITIES & EDUCATION</p>
            <h1>Skills & coursework</h1>
            <p class="body-copy muted">A concise view of tools used across projects and coursework recorded through Fall 2026.</p>
            <h2>Skills</h2>
            <div class="skill-groups">
              {% for group in skills.groups %}
                <section class="skill-group"><h3>{{ group.name }}</h3><ul class="tag-list">{% for item in group.items %}<li>{{ item }}</li>{% endfor %}</ul></section>
              {% endfor %}
            </div>
            <h2 class="course-heading">Coursework</h2>
            <p class="course-intro">Course status as of Fall 2026. Individual grades are not displayed.</p>
            <section class="course-section" aria-labelledby="technical-coursework-heading">
              <h3 id="technical-coursework-heading">Technical coursework</h3>
              <div class="course-table-wrap" role="region" aria-label="Technical coursework by semester" tabindex="0">
                <table class="course-table">
                  <thead><tr><th scope="col">Semester</th><th scope="col">Code</th><th scope="col">Course</th><th scope="col">Status</th></tr></thead>
                  <tbody>
                    {% for course in skills.coursework %}
                      {% if course.group == "technical" %}
                        <tr><td>{{ course.term }}</td><td>{{ course.code }}</td><td>{{ course.name }}</td><td><span class="course-status{% if course.status == 'In progress' %} status-in-progress{% endif %}">{{ course.status }}</span></td></tr>
                      {% endif %}
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </section>
            <details class="additional-coursework">
              <summary>Additional coursework</summary>
              <div class="course-table-wrap" role="region" aria-label="Additional coursework by semester" tabindex="0">
                <table class="course-table">
                  <thead><tr><th scope="col">Semester</th><th scope="col">Code</th><th scope="col">Course</th><th scope="col">Status</th></tr></thead>
                  <tbody>
                    {% for course in skills.coursework %}
                      {% if course.group == "additional" %}
                        <tr><td>{{ course.term }}</td><td>{{ course.code }}</td><td>{{ course.name }}</td><td><span class="course-status">{{ course.status }}</span></td></tr>
                      {% endif %}
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </details>
          </article>
        </section>
      </section>

      <section class="terminal" id="terminal-panel" aria-label="Decorative editor panel">
        <div class="panel-tabs" role="tablist" aria-label="Editor panels">
          <button type="button" role="tab" aria-selected="false" data-panel="problems">Problems</button>
          <button type="button" role="tab" aria-selected="false" data-panel="output">Output</button>
          <button type="button" role="tab" aria-selected="false" data-panel="debug">Debug Console</button>
          <button type="button" role="tab" aria-selected="true" class="panel-active" data-panel="terminal">Terminal</button>
          <button type="button" role="tab" aria-selected="false" data-panel="ports">Ports</button>
          <button type="button" role="tab" aria-selected="false" data-panel="jupyter">Jupyter</button>
          <button class="panel-collapse" type="button" aria-expanded="true" aria-controls="panel-content">Collapse panel</button>
        </div>
        <div class="panel-content" id="panel-content" role="tabpanel" aria-live="polite">
          <pre data-panel-content="terminal"><span class="prompt">PS C:\jack311045\jack311045&gt;</span> portfolio
Static portfolio preview. No shell commands are executed.</pre>
        </div>
      </section>
      <footer class="statusbar"><span>Portfolio</span><span>UTF-8</span><span>Static site</span></footer>
    </main>
  </body>
</html>
